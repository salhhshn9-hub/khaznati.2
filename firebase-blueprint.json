{
  "entities": {
    "VaultAccount": {
      "title": "VaultAccount",
      "description": "An email identity or connected application/website account stored in a user's personal vault.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "recordType": {
          "type": "string",
          "enum": ["email", "app"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "platformKey": {
          "type": "string",
          "maxLength": 60
        },
        "category": {
          "type": "string",
          "enum": [
            "email",
            "social",
            "work",
            "finance",
            "gaming",
            "entertainment",
            "shopping",
            "government",
            "education",
            "other"
          ]
        },
        "emailAddress": {
          "type": "string",
          "maxLength": 160
        },
        "parentEmailId": {
          "type": "string",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "maxLength": 120
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "password": {
          "type": "string",
          "maxLength": 512
        },
        "loginMethod": {
          "type": "string",
          "enum": [
            "email_password",
            "google_oauth",
            "apple_id",
            "phone_otp",
            "username_password",
            "sso"
          ]
        },
        "websiteUrl": {
          "type": "string",
          "maxLength": 300
        },
        "phoneNumber": {
          "type": "string",
          "maxLength": 40
        },
        "recoveryEmail": {
          "type": "string",
          "maxLength": 160
        },
        "recoveryPhone": {
          "type": "string",
          "maxLength": 40
        },
        "registeredBirthdate": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        },
        "accountCreatedAt": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        },
        "lastPasswordChangedAt": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        },
        "twoFactorEnabled": {
          "type": "boolean"
        },
        "twoFactorMethod": {
          "type": "string",
          "enum": [
            "none",
            "authenticator",
            "sms",
            "email",
            "hardware_key",
            "biometric"
          ]
        },
        "backupCodes": {
          "type": "string",
          "maxLength": 1000
        },
        "securityQuestions": {
          "type": "array",
          "description": "Up to 5 security question and answer pairs."
        },
        "pinCode": {
          "type": "string",
          "maxLength": 32
        },
        "subscriptionStatus": {
          "type": "string",
          "enum": ["none", "free", "monthly", "yearly", "lifetime"]
        },
        "subscriptionCost": {
          "type": "string",
          "maxLength": 40
        },
        "renewalDate": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        },
        "primaryDevice": {
          "type": "string",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended", "needs_update", "archived"]
        },
        "isFavorite": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "recordType",
        "title",
        "platformKey",
        "category",
        "emailAddress",
        "parentEmailId",
        "username",
        "displayName",
        "password",
        "loginMethod",
        "websiteUrl",
        "phoneNumber",
        "recoveryEmail",
        "recoveryPhone",
        "registeredBirthdate",
        "accountCreatedAt",
        "lastPasswordChangedAt",
        "twoFactorEnabled",
        "twoFactorMethod",
        "backupCodes",
        "securityQuestions",
        "pinCode",
        "subscriptionStatus",
        "subscriptionCost",
        "renewalDate",
        "primaryDevice",
        "status",
        "isFavorite",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "VaultPreferences": {
      "title": "VaultPreferences",
      "description": "User-level vault preferences including real birthdate baseline and lock configuration.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "realBirthdate": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        },
        "vaultPinHash": {
          "type": "string",
          "maxLength": 128
        },
        "autoLockMinutes": {
          "type": "number"
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "realBirthdate",
        "vaultPinHash",
        "autoLockMinutes",
        "theme",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/VaultAccount" },
      "description": "Stores email identities and linked app/website accounts scoped strictly to the authenticated owner."
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/VaultPreferences" },
      "description": "Stores user vault settings such as real birthdate baseline, theme, and PIN lock hash."
    }
  }
}
